{
  "rewrites": [
    { "source": "/api/todos/:id", "destination": "/api/todos?id=:id" },
    { "source": "/game", "destination": "/api/game" },
    { "source": "/game/", "destination": "/api/game" },
    { "source": "/retirement", "destination": "/api/retirement?page=1" },
    { "source": "/retirement/", "destination": "/api/retirement?page=1" },
    { "source": "/((?!api/|@|.*\\.).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/game.ts": { "includeFiles": "api/_game/index.html" },
    "api/retirement.ts": { "includeFiles": "api/_retirement/index.html" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
